# Break the AI App — copy to .env and edit for your host.
# Do not commit .env (it may contain secrets).
#
# Defaults below match the CCI demo VM (cci-demo.ucd.ie): app on port 5001,
# LLM on worf at 172.28.0.153:8001. Adjust if you deploy elsewhere.

# Bind address for published port. Use 127.0.0.1 for laptop-only.
# Use 0.0.0.0 on a server so participants can reach it on the LAN.
HOST_BIND=0.0.0.0
HOST_PORT=5001

APP_MODE=vulnerable
DM_RPG_MODE=pilot
SESSION_SECRET=change-me-before-server-use

# OpenAI-compatible chat completions endpoint reachable FROM the container.
#
# CCI demo / any host that is not worf (app → worf LLM on the LAN):
LLM_URL=http://172.28.0.153:8001/v1/chat/completions
#
# If the app AND the LLM both run on worf:
#   LLM_URL=http://host.docker.internal:8001/v1/chat/completions
# (compose already adds host.docker.internal → host gateway on Linux)
LLM_MODEL=unsloth/Qwen3.8-27B-NVFP4
LLM_API_KEY=CSG-ORBIT-EXFIL-9
LLM_TIMEOUT=120

# Max simultaneous pilot chats that may call the LLM (0 = unlimited).
# Set after load tests in docs/testing_throughput.md (e.g. 10).
MAX_INFLIGHT_CHATS=0

# Optional warmup room gate (docker-compose.room-auth.yml).
# On cci-demo the VM already has nginx Basic Auth — do not enable this overlay
# unless you want a second login prompt.
# Put real values in .env (not committed). Then:
#   ./scripts/make-room-htpasswd.sh
#   docker compose -f docker-compose.yml -f docker-compose.room-auth.yml up -d
# ROOM_USER=username
# ROOM_PASSWORD=password
