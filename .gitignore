# ── Models (large binary, downloaded by scripts/download_model.py) ────────────
models/*.gguf
models/*.part

# ── Database (regenerated by scripts/seed.py) ─────────────────────────────────
data/workshop.db

# ── Python bytecode & caches ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Optional room Basic Auth password file (copy from htpasswd.example) ───────
deploy/room-auth/htpasswd

# ── IDE / editor artefacts ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── macOS metadata ────────────────────────────────────────────────────────────
.DS_Store

# ── Docker build cache (BuildKit) ─────────────────────────────────────────────
.dockerignore

# NOTE: __init__.py files are intentionally NOT excluded — they are Python
# package markers and belong in source control.
